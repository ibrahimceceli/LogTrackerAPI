<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Request timing, exception logging and reporting for ASP.NET Core APIs, backed by SQL Server.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Microsoft.Data.SqlClient 7.1.1 still depends on System.Security.Cryptography.Pkcs 9.0.x,
         which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Pin the patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LogTracker.Core.Tests" />
    <InternalsVisibleTo Include="LogTracker.Api.Tests" />
  </ItemGroup>

</Project>
