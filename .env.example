# Settings for docker-compose.yml.
# Copy this file to ".env" (Docker Compose reads it automatically) and adjust the values.
# .env is git-ignored - never commit real passwords or tokens.

# --- SQL Server -------------------------------------------------------------
# Password of the "sa" login of the SQL Server container (required).
# SQL Server needs at least 8 characters from three of: uppercase, lowercase,
# digits, symbols. Avoid ; ' " $ and spaces - the password is also put into
# the API's connection string. This is a local demo container, but still pick your own.
MSSQL_SA_PASSWORD=LogTracker_Dev_2026

# Host port for SQL Server, e.g. for SSMS or Azure Data Studio: localhost,14333
DB_PORT=14333

# --- API --------------------------------------------------------------------
# Host port of the API and dashboard: http://localhost:8080
API_PORT=8080

# Optional API key. Empty = /api/reports/* is open. When set, report requests
# need the header "X-Api-Key: <value>".
LOGTRACKER_API_KEY=

# Telegram alerts for new errors (optional, off by default).
# Create a bot with @BotFather to get a token; the chat id is your user or group id.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Simulator (only runs with: docker compose --profile demo up) -----------
# Virtual users sending requests in parallel (1-50).
SIMULATOR_CONCURRENCY=4
# Random pause between two requests of one user, in milliseconds.
SIMULATOR_MIN_DELAY_MS=200
SIMULATOR_MAX_DELAY_MS=1500
# Share of requests (0-100) that call /api/test/errors/{type} and return 500.
SIMULATOR_ERROR_PERCENT=10
# Stop after this many seconds; empty = run until the stack is stopped.
SIMULATOR_DURATION_SECONDS=
# Seconds between two summaries in the simulator log; 0 = only the final summary.
SIMULATOR_SUMMARY_INTERVAL_SECONDS=30
